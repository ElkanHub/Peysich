# ── Database ──────────────────────────────────────────────
# Local dev: docker compose up -d  →  this URL works as-is.
# Production: Neon connection string (see HANDOFF.md)
DATABASE_URL=postgres://peysich:peysich@localhost:5432/peysich

# ── App ───────────────────────────────────────────────────
# Root domain the app is served on. Local dev uses localhost:3000
# (subdomains work natively: stmarys.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# ── Google sign-in (optional in dev; HANDOFF.md) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 (optional in dev; HANDOFF.md) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=schoolspec

# ── Paystack (optional in dev — fake-payment mode; HANDOFF.md)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Email / SMS (optional in dev; docs/CONNECTIONS.md §3–4) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com
SMS_API_KEY=
CRON_SECRET=

# ── Push notifications (optional; docs/CONNECTIONS.md §5) ──
# generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
